      "name": "Introduction Primary Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary link on the green introduction.",
      "html": "<a class=\"ds-hero-primary\" href=\"research.html\">Explore research</a>",
      "css": ".ds-hero-primary{display:inline-flex;align-items:center;min-height:46px;padding:13px 19px;border:1px solid #a9e7b7;border-radius:3px;background:#a9e7b7;color:#1d302b;font:600 12px/1.62 var(--sans,'DM Sans','Segoe UI',sans-serif);text-decoration:none;transition:background-color 220ms ease,color 220ms ease,transform 300ms cubic-bezier(.22,1,.36,1)}.ds-hero-primary:hover{background:#d6f5de;border-color:#d6f5de}.ds-hero-primary:focus-visible{outline:3px solid #a9e7b7;outline-offset:3px}.ds-hero-primary:active{transform:translateY(1px)}@media(max-width:980px){.ds-hero-primary{padding:12px 14px}}@media(prefers-reduced-motion:reduce){.ds-hero-primary{transition:none}}"
    },
    {
      "name": "Introduction Secondary Action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined article-archive link on green.",
      "html": "<div class=\"ds-hero-frame\"><a class=\"ds-hero-secondary\" href=\"publications.html\">Publications</a></div>",
      "css": ".ds-hero-frame{background:#1d302b;padding:20px}.ds-hero-secondary{display:inline-flex;align-items:center;min-height:46px;padding:13px 19px;border:1px solid #7f9b8c;border-radius:3px;background:transparent;color:#f7faf5;font:600 12px/1.62 var(--sans,'DM Sans','Segoe UI',sans-serif);text-decoration:none;transition:background-color 220ms ease,color 220ms ease}.ds-hero-secondary:hover{background:#d6f5de;border-color:#d6f5de;color:#1d302b}.ds-hero-secondary:focus-visible{outline:3px solid #a9e7b7;outline-offset:3px}.ds-hero-secondary:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-hero-secondary{transition:none}}"
    },
    {
      "name": "Archive Filter",
      "kind": "chip",
      "refersTo": "filter",
      "description": "Status or category control, with its selected state.",
      "html": "<button class=\"ds-filter ds-focus\" aria-pressed=\"false\">Published</button><button class=\"ds-filter ds-focus ds-selected\" aria-pressed=\"true\">All</button>",
      "css": ".ds-filter{min-height:44px;padding:10px 14px;border:1px solid #cbd5d1;border-radius:2px;background:var(--paper,#ffffff);color:#40504a;font:500 12px/1.62 var(--sans,'DM Sans','Segoe UI',sans-serif);cursor:pointer;transition:background-color 220ms ease,color 220ms ease}.ds-filter:hover,.ds-selected{background:var(--blue,#315e4b);border-color:var(--blue,#315e4b);color:#fff}.ds-filter:active{transform:translateY(1px)}.ds-focus:focus-visible{outline:3px solid rgba(24,91,95,.34);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-filter{transition:none}}"
    },
    {
      "name": "Archive Search",
      "kind": "input",
      "refersTo": "search",
      "description": "Publication or resource search field.",
      "html": "<input class=\"ds-search ds-focus\" type=\"search\" aria-label=\"Search publications\" placeholder=\"Search title, author, journal\u2026\">",
      "css": ".ds-search{min-height:46px;padding:9px 12px;border:1px solid #c5d0cc;border-radius:3px;background:var(--paper,#ffffff);color:var(--ink,#253b34);font:400 13px/1.62 var(--sans,'DM Sans','Segoe UI',sans-serif);caret-color:var(--blue,#315e4b)}.ds-search::placeholder{color:var(--muted,#59655f);opacity:1}.ds-search:focus{border-color:var(--blue,#315e4b)}.ds-focus:focus-visible{outline:3px solid rgba(24,91,95,.34);outline-offset:3px}"
    },
    {
      "name": "Green Navigation",
      "kind": "nav",
      "description": "Medium-weight sans-serif navigation inside the persistent green frame.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Primary navigation\"><a href=\"research.html\">Research</a><a href=\"publications.html\" aria-current=\"page\">Publications</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:clamp(16px,1.8vw,28px);padding:20px;background:#1d302b}.ds-nav a{display:inline-flex;align-items:center;position:relative;min-height:44px;color:#f7faf5;font:500 14px/1.62 var(--sans,'DM Sans','Segoe UI',sans-serif);text-decoration:none}.ds-nav a:hover,.ds-nav a[aria-current]{color:#a9e7b7}.ds-nav a::after{content:'';position:absolute;bottom:-8px;left:0;width:100%;height:1px;background:#a9e7b7;transform:scaleX(0);transform-origin:right;transition:transform .25s ease}.ds-nav a:hover::after,.ds-nav a[aria-current]::after{transform:scaleX(1);transform-origin:left}.ds-nav a:focus-visible{outline:3px solid #a9e7b7;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-nav a::after{transition:none}}"
    },
    {
